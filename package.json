{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"resources/js/**/*.{js,ts,tsx}\" \"tests/Unit/*.test.ts\" eslint.config.js vite.config.js .prettierrc.json",
    "format:check": "prettier --check \"resources/js/**/*.{js,ts,tsx}\" \"tests/Unit/*.test.ts\" eslint.config.js vite.config.js .prettierrc.json",
    "lint": "eslint resources/js tests/Unit/*.test.ts eslint.config.js vite.config.js --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "node --test tests/Unit/*.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.0"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@inertiajs/react": "^2.3.29",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
